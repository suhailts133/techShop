NODE_ENV=development
PORT=3000

# Database URIs
MONGODB_URI=mongodb://127.0.0.1:27017/techshop?replicaSet=rs0
MONGODB_ATLAS_URI=your_mongodb_atlas_uri

# Authentication & Sessions
SESSION_SECRET=your_session_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Payment Gateway
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Email Service (Brevo)
BREVO_API_KEY=your_brevo_api_key
BREVO_SENDER=your_verified_sender_email

# Application URIs
DEV_URI=http://localhost:3000/
DEV_CALLBACK_URI=http://localhost:3000/auth/google/callback
PROD_URI=your_production_deployment_url
PROD_CALLBACK_URI=your_production_deployment_url/auth/google/callback
